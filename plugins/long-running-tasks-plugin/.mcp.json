{
  "mcpServers": {
    "long_running_tasks": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--project",
        ".",
        "python",
        "-m",
        "long_running_tasks.mcp_server"
      ],
      "cwd": ".",
      "startup_timeout_sec": 10,
      "tool_timeout_sec": 3600,
      "default_tools_approval_mode": "prompt",
      "tools": {
        "start_run": {
          "approval_mode": "prompt"
        },
        "resume_run": {
          "approval_mode": "prompt"
        },
        "cancel_run": {
          "approval_mode": "prompt"
        },
        "recover_run": {
          "approval_mode": "prompt"
        }
      }
    }
  }
}
